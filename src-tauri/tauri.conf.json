{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dynamic Island",
  "version": "0.3.1",
  "identifier": "com.dynamicisland.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "island.html",
        "title": "Dynamic Island",
        "width": 152,
        "height": 70,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Raul Nuñez",
    "copyright": "Copyright (c) 2026 Raul Nuñez",
    "category": "Utility",
    "shortDescription": "Isla dinámica para el escritorio de Windows",
    "longDescription": "Isla dinámica anclada al borde superior de la pantalla: música del sistema, letras sincronizadas, avisos y notificaciones de aplicaciones.",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
